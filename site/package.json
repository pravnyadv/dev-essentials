{
  "name": "dsa-js",
  "version": "0.0.47",
  "private": true,
  "scripts": {
    "content": "node scripts/ensure-source.mjs && node scripts/build-content.mjs ../vendor/javascript-algorithms/src && node scripts/build-docs.mjs && node scripts/build-ai.mjs",
    "predev": "npm run content",
    "dev": "next dev",
    "prebuild": "npm run content",
    "build": "next build",
    "start": "serve out",
    "verify": "npm run content && node scripts/verify.mjs && next build",
    "types:check": "next typegen && tsc --noEmit",
    "links": "node scripts/check-links.mjs",
    "lint:ai": "node scripts/lint-ai.mjs",
    "coverage": "node scripts/coverage-roadmap.mjs",
    "ai:stars": "node scripts/ai-stars.mjs",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "cn": "^0.4.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.5",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@biomejs/biome": "^2.5.15"
  }
}
